{
  "name": "figma-ui3-kit-svelte",
  "version": "1.0.0-rc.0",
  "type": "module",
  "description": "A collection of Svelte 5 components that match Figma UI3 for building plugins",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "svelte": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": [
    "./src/index.ts",
    "./src/global.css"
  ],
  "peerDependencies": {
    "svelte": "^5.35.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma/code-connect": "^2.0.1",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-themes": "^8.6.15",
    "@storybook/svelte": "^8.6.14",
    "@storybook/svelte-webpack5": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.23.0",
    "picomatch": "^4.0.3",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.4.1",
    "storybook": "^8.6.14",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.6",
    "svelte-loader": "^3.2.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "lint": "npm run check && eslint src/ && prettier --check \"src/**/*.{js,ts,svelte}\" \".storybook/*.svelte\"",
    "lint:fix": "eslint src/ --fix",
    "prettier": "npx prettier --write \"src/**/*.{js,ts,svelte,html,css}\"",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "figma:icons": "node figma/scripts/import-icons.mjs",
    "figma:parse": "figma connect parse",
    "figma:publish": "npm run figma:icons && figma connect publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mariusroosendaal/figma-ui3-kit-svelte.git"
  },
  "keywords": [
    "figma",
    "plugin",
    "design-system",
    "ui-components",
    "svelte",
    "figma-ui3"
  ],
  "author": "Marius Roosendaal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mariusroosendaal/figma-ui3-kit-svelte/issues"
  },
  "homepage": "https://github.com/mariusroosendaal/figma-ui3-kit-svelte#readme"
}
